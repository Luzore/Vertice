# VÉRTICE — variables de entorno (ROADMAP §5). Solo nombres, sin valores.
# Copia este archivo a .env y llena los valores. .env NUNCA se sube a git.

# --- Mercado + noticias (obligatorio) · Alpaca, cuenta paper ---
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Noticias, resultados, fundamentales, insiders (obligatorio) · Finnhub ---
FINNHUB_API_KEY=

# --- Macro (obligatorio) · FRED ---
FRED_API_KEY=

# --- SEC EDGAR: no hay key; nombre + email obligatorios. Ej.: "VERTICE Nombre Apellido tu_email@dominio.com"
SEC_USER_AGENT=

# --- Alertas · Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- IA · Claude Code CLI. Vacío = usa el login de tu suscripción (recomendado).
#     Solo si pagas por uso con la API: define la key (el wrapper agregará --bare).
ANTHROPIC_API_KEY=

# --- Opcionales ---
MASSIVE_API_KEY=
BANXICO_TOKEN=

# --- VPS (despliegue, Fase 9) ---
VPS_HOST=
VPS_USER=
VPS_SSH_KEY_PATH=

# --- Base de datos (opcional). Por defecto: SQLite en data/vertice.db
# DATABASE_URL=
